# Non-secret config for the AgileX Piper REAL-arm agent (committed).
ROBOT_NAME=PiperRealArm
API_HOST=0.0.0.0
API_PORT=8213

# MCP endpoint of the piper-real toolset (default port 8212).
PIPER_TOOLSET_URL=http://localhost:8212/mcp

# Real hardware: keep operations strictly sequential.
ALLOW_PARALLEL_TOOL_CALLS=false
ENVIRONMENT=local
