<mujoco model="piper_sim">
  <!-- Digital-twin scene for sim/piper_sim.py: the menagerie Piper on a table whose top is z=0 (the base plate
       sits on it, so the flange at zero joints is 213 mm up, as on the real table), a hollow bowl (thin box walls:
       MuJoCo collides meshes as convex hulls, a mesh bowl would be solid), a 30 mm free block, two lights and the
       'top' camera. The 'wrist' camera lives on link6 in assets/agilex_piper/piper.xml. Metres here; the bowl
       centre and the block spawn come from piper/config.py (Sim section) and are applied at load. -->
  <include file="assets/agilex_piper/piper.xml"/>

  <visual>
    <headlight diffuse="0.25 0.25 0.25" ambient="0.2 0.2 0.2" specular="0.05 0.05 0.05"/>
    <global offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.75 0.8 0.88" rgb2="0.35 0.4 0.5" width="256" height="1536"/>
    <texture name="table_tex" type="2d" builtin="checker" rgb1="0.62 0.54 0.42" rgb2="0.58 0.50 0.38" width="64" height="64"/>
    <material name="table_mat" texture="table_tex" texrepeat="12 12" texuniform="true" reflectance="0.05"/>
    <material name="bowl_mat" rgba="0.35 0.45 0.7 1"/>
    <material name="block_mat" rgba="0.85 0.15 0.1 1"/>
  </asset>

  <worldbody>
    <light directional="true" pos="0.3 0.3 1.5" dir="-0.2 -0.2 -1" diffuse="0.45 0.45 0.45" specular="0.1 0.1 0.1"/>
    <light pos="0.6 -0.6 1.2" dir="-0.4 0.5 -1" diffuse="0.25 0.25 0.25"/>
    <geom name="floor" type="plane" size="3 3 0.1" pos="0 0 -0.75" rgba="0.4 0.4 0.42 1"/>
    <geom name="table" type="box" size="0.45 0.45 0.01" pos="0.25 0 -0.01" material="table_mat" friction="1 0.005 0.0001"/>

    <body name="bowl" pos="0.28 -0.15 0">
      <geom name="bowl_floor" type="cylinder" size="0.061 0.002" pos="0 0 0.002" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="0.0580 0.0000 0.02" euler="0 0 90.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="0.0502 0.0290 0.02" euler="0 0 120.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="0.0290 0.0502 0.02" euler="0 0 150.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="0.0000 0.0580 0.02" euler="0 0 180.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="-0.0290 0.0502 0.02" euler="0 0 210.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="-0.0502 0.0290 0.02" euler="0 0 240.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="-0.0580 0.0000 0.02" euler="0 0 270.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="-0.0502 -0.0290 0.02" euler="0 0 300.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="-0.0290 -0.0502 0.02" euler="0 0 330.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="0.0000 -0.0580 0.02" euler="0 0 0.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="0.0290 -0.0502 0.02" euler="0 0 30.0" material="bowl_mat"/>
      <geom type="box" size="0.0159 0.003 0.02" pos="0.0502 -0.0290 0.02" euler="0 0 60.0" material="bowl_mat"/>
    </body>

    <body name="block" pos="0.27 0.06 0.015">
      <freejoint name="block"/>
      <geom name="block" type="box" size="0.015 0.015 0.015" mass="0.03" friction="1.5 0.02 0.0005" condim="4"
        material="block_mat"/>
    </body>

    <camera name="top" pos="0.42 0 0.70" xyaxes="0 1 0 -0.9778 0 0.2095" fovy="50"/>
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="world"/>
  </contact>
</mujoco>
