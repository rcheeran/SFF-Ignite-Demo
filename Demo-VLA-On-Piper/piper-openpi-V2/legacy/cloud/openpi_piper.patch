+import dataclasses
+
+import einops
+import numpy as np
+
+from openpi import transforms
+from openpi.models import model as _model
+
+
+def make_piper_example() -> dict:
+    """Random input example for the single-arm Piper policy (10-D pose+gripper)."""
+    return {
+        "observation/state": np.random.rand(10).astype(np.float32),
+        "observation/wrist_image": np.random.randint(256, size=(224, 224, 3), dtype=np.uint8),
+        "prompt": "pick up the soda can",
+    }
+
+
+def _parse_image(image) -> np.ndarray:
+    image = np.asarray(image)
+    if np.issubdtype(image.dtype, np.floating):
+        image = (255 * image).astype(np.uint8)
+    if image.shape[0] == 3:  # LeRobot stores float32 CHW; model wants HWC uint8
+        image = einops.rearrange(image, "c h w -> h w c")
+    return image
+
+
+@dataclasses.dataclass(frozen=True)
+class PiperInputs(transforms.DataTransformFn):
+    """Map our single-wrist-cam, 10-D pose+gripper data into the pi0.5 input format.
+
+    We have one eye-in-hand D405. pi0 takes up to 3 image slots (one base + two
+    wrist); we duplicate our wrist view into base_0_rgb + left_wrist_0_rgb (both
+    real) and zero/mask the right wrist. State/actions are 10-D
+    [x, y, z, R6d(6), gripper]; the framework pads them to the model dim.
+    """
+
+    model_type: _model.ModelType
+
+    def __call__(self, data: dict) -> dict:
+        wrist = _parse_image(data["observation/wrist_image"])
+        inputs = {
+            "state": data["observation/state"],
+            "image": {
+                "base_0_rgb": wrist,
+                "left_wrist_0_rgb": wrist,
+                "right_wrist_0_rgb": np.zeros_like(wrist),
+            },
+            "image_mask": {
+                "base_0_rgb": np.True_,
+                "left_wrist_0_rgb": np.True_,
+                "right_wrist_0_rgb": np.True_ if self.model_type == _model.ModelType.PI0_FAST else np.False_,
+            },
+        }
+        if "actions" in data:
+            inputs["actions"] = data["actions"]
+        if "prompt" in data:
+            inputs["prompt"] = data["prompt"]
+        return inputs
+
+
+@dataclasses.dataclass(frozen=True)
+class PiperOutputs(transforms.DataTransformFn):
+    """Return the first 10 action dims (the model pads to action_dim; we unpad)."""
+
+    def __call__(self, data: dict) -> dict:
+        return {"actions": np.asarray(data["actions"][..., :10])}
