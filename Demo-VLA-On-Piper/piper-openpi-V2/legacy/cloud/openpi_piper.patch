+@dataclasses.dataclass(frozen=True)
+class LeRobotPiperDataConfig(DataConfigFactory):
+    """Single-arm AgileX Piper, pose-6D control, one eye-in-hand D405 camera.
+
+    Dataset (built by ~/Documents/piper-openpi/build_pose_lerobot.py) stores:
+      wrist_image : (224,224,3)
+      state       : 10-D  [x_mm, y_mm, z_mm, R6d(6), gripper_m]
+      actions     : 10-D  absolute next-frame pose+gripper (already the target)
+    Actions are ABSOLUTE (no delta transform): the model predicts the next pose
+    directly, and gripper/rotation-6D don't play well with per-chunk deltas.
+    """
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        # Rename dataset columns -> the observation/* keys our policy transform expects
+        # (mirrors what the live inference pipeline will feed the policy server).
+        repack_transform = _transforms.Group(
+            inputs=[
+                _transforms.RepackTransform(
+                    {
+                        "observation/wrist_image": "wrist_image",
+                        "observation/state": "state",
+                        "actions": "actions",
+                        "prompt": "prompt",
+                    }
+                )
+            ]
+        )
+
+        # Map into the pi0.5 model format (image slots, pad state/actions). Applied
+        # at train time AND inference. Defined in piper_policy.py.
+        data_transforms = _transforms.Group(
+            inputs=[piper_policy.PiperInputs(model_type=model_config.model_type)],
+            outputs=[piper_policy.PiperOutputs()],
+        )
+
+        # Train on DELTA actions (relative to the current pose); gripper stays
+        # absolute. With absolute next-pose actions the trivial "copy the state"
+        # solution already achieves ~0.01 normalized loss without using the
+        # camera - the v1 policy learned exactly that and random-walked on the
+        # robot. Deltas are normalized by motion scale, forcing vision use.
+        delta_mask = _transforms.make_bool_mask(9, -1)
+        data_transforms = data_transforms.push(
+            inputs=[_transforms.DeltaActions(delta_mask)],
+            outputs=[_transforms.AbsoluteActions(delta_mask)],
+        )
+
+        # Tokenize prompt, resize images, pad state/actions to the model dim.
+        model_transforms = ModelTransformFactory()(model_config)
+
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack_transform,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+        )
+
+
